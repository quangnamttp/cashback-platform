# Admin console protection (server-side Basic Auth via middleware.ts)
# Set these on your hosting provider (Vercel/VPS/Docker), NOT in git.
# If unset, defaults below are used (change before deploying publicly).
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=31102001

# Support chat widget -> Telegram relay (see app/api/support-chat/send/route.ts)
# 1. Create a bot via @BotFather on Telegram, copy its token below.
# 2. Message the bot (or add it to a group), then find your chat id via
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# Without these set, the chat widget will show a clear "not configured" message.
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_CHAT_ID=
