# Firebase project config (public by design — protected by Firestore
# Security Rules, not by hiding these values). From Firebase Console >
# Project settings > General > Your apps > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hoantiendv.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hoantiendv
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hoantiendv.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google OAuth 2.0 Client ID (Web application) — lets each signed-in user's
# browser connect their OWN Google Drive (avatar photos, admin log backups)
# entirely client-side, no server/service-account involved. From Google
# Cloud Console > APIs & Services > Credentials > Create OAuth client ID.
# Authorized JavaScript origins must include your Hosting domain(s) and
# http://localhost:3000 for local dev. Public value, safe to ship.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Optional: forwards each new customer live-chat message to a Telegram
# group/chat as a notification (one-way only — see lib/telegram.ts for why
# a reply typed on Telegram cannot auto-appear on the web without a paid
# backend). Leave both empty to disable. WARNING: this token ships inside
# the public JS bundle (there is no server to keep it secret on a static
# export) — use a bot dedicated to this one purpose only, and rotate the
# token from @BotFather if it's ever abused.
# 1. Create a bot via @BotFather, copy its token below.
# 2. Add the bot to your Telegram group, then get the group's chat id
#    (e.g. open https://api.telegram.org/bot<TOKEN>/getUpdates after
#    sending a message in the group) and paste it below (often negative
#    for groups, e.g. -1001234567890).
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_CHAT_ID=
