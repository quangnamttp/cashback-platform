# Core app
NODE_ENV=development
APP_PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cashback_platform?schema=public"
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="replace-with-a-long-random-secret"

# Provider configuration placeholders
SHOPEE_CLIENT_ID="replace-with-shopee-client-id"
SHOPEE_CLIENT_SECRET="replace-with-shopee-client-secret"
TIKTOK_SHOP_ACCESS_TOKEN="replace-with-tiktok-shop-token"
LAZADA_APP_KEY="replace-with-lazada-app-key"
LAZADA_APP_SECRET="replace-with-lazada-app-secret"
VERCEL_AI_GATEWAY_API_KEY="replace-with-vercel-ai-gateway-key"
VERCEL_AI_GATEWAY_URL="https://ai-gateway.vercel.sh"

# Frontend environment
NEXT_PUBLIC_APP_NAME="Cashback Platform"
NEXT_PUBLIC_ENABLE_ANALYTICS=false
