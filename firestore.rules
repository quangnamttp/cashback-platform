rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // No Cloud Functions / Admin SDK in this architecture — every write is
    // either the account owner touching their own non-sensitive data, or an
    // admin whose privilege is established by their OWN users/ doc (there is
    // no custom claim to check anymore). BOOTSTRAP_ADMIN_EMAIL is the only
    // account allowed to self-promote to admin, exactly once, at signup.
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Hard email allowlist, checked on EVERY admin-gated read/write — not
    // just at account-creation time. This is deliberate belt-and-suspenders:
    // even if a users/{uid} doc somehow ends up with role=='admin' (stale
    // test data, a bug elsewhere), it grants nothing unless the signed-in
    // token's own email is also one of these two. Combined with users/update
    // below forbidding anyone from ever writing the `role` field again,
    // there is no path — UI or direct Firestore write — for a third email to
    // ever become admin. Must match BOOTSTRAP_ADMIN_EMAILS in
    // apps/web/lib/auth.tsx exactly.
    function isBootstrapAdminEmail(email) {
      return email == 'quangnamttp@gmail.com' || email == 'hoantiendv@gmail.com';
    }
    function isAdmin() {
      return isSignedIn()
        && isBootstrapAdminEmail(request.auth.token.email)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // The Telegram "✅ Đã thanh toán" button (workers/telegram-bot) signs in
    // as this ONE dedicated Firebase Auth account to write back to
    // Firestore, instead of an Admin SDK service-account key — a leaked
    // Admin SDK key bypasses every rule in this whole file, while a leaked
    // credential for this account can only ever do the one thing
    // withdrawalRequests/update below allows it to do. Not an admin: this
    // identity is never checked by isAdmin() and grants nothing anywhere
    // else in this database. Replace the placeholder with the real uid of
    // that account (Firebase Console → Authentication → Users) before
    // deploying the Worker.
    function isPaymentBot() {
      return isSignedIn() && request.auth.uid == 'eMg2P3tFgGgZQCDDy6GEslQpWDt2';
    }

    match /users/{uid} {
      // Also readable by whoever referred this account — /referrals shows
      // "who signed up with my code" by querying where('referredBy','==',
      // myCode); Firestore evaluates that per returned document, so this
      // looks up the requester's OWN referralCode via get() and compares.
      // isPaymentBot() needs this too: confirming an order from Telegram
      // (handleOrderDecision) has to read the customer's name/email for
      // the message text and referredBy to resolve a referrer bonus, the
      // exact same fields addCommissionLedgerEntries() reads on the web
      // side as isAdmin(). Read-only, and only ever a name/email/referral
      // code — nothing this identity can act on beyond what its narrow
      // write permissions elsewhere already allow.
      allow read: if isOwner(uid) || isAdmin() || isPaymentBot()
        || (isSignedIn()
            && resource.data.referredBy != null
            && resource.data.referredBy == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode);
      allow create: if isOwner(uid)
        && request.resource.data.role == (isBootstrapAdminEmail(request.auth.token.email) ? 'admin' : 'user')
        && request.resource.data.status == 'ACTIVE';
      // `role` is permanently immutable after creation — there is no
      // "promote to admin" path for anyone, including isAdmin() itself.
      // Admin status is decided ONLY once, by isBootstrapAdminEmail() at
      // account-creation time above. `status` (ACTIVE/LOCKED) stays
      // admin-only to change.
      allow update: if !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && (isAdmin()
            || (isOwner(uid) && !('status' in request.resource.data.diff(resource.data).affectedKeys())));
      allow delete: if false;
    }

    // A maintained running counter (see lib/walletBalance.ts) used ONLY to
    // let withdrawalRequests/create below cap a request's amount with a
    // single get() — firestore.rules cannot itself sum cashbackLedger, so
    // without this there was no server-side check at all on a withdrawal
    // amount. The wallet UI itself still always computes the real,
    // displayed balance by summing cashbackLedger live, never by trusting
    // this field for display.
    //
    // Only isAdmin()/isPaymentBot() can ever CREATE this doc or INCREASE
    // it (crediting a release, or refunding a rejected withdrawal — both
    // already-trusted actions elsewhere in this file). The owner may only
    // DECREASE their own value, and never below 0 — that's the one write a
    // customer legitimately needs to make themselves, atomically alongside
    // creating their own withdrawal request (reserving the amount). A
    // customer can therefore spend their own ceiling down but can never
    // raise it, so self-writing this doc can't be used to inflate what
    // they're later allowed to withdraw.
    match /walletBalances/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || isPaymentBot();
      allow update: if isAdmin() || isPaymentBot()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available'])
            && request.resource.data.available >= 0
            && request.resource.data.available <= resource.data.available);
      allow delete: if false;
    }

    // Doc id is `${uid}_${deviceId}` — deviceId is a random id persisted in
    // that browser/app's own localStorage (lib/device.ts), so each browser
    // or app install gets its own independent session slot and logging in
    // from a second browser never overwrites (and therefore never kicks)
    // a different one. Admin can still see/force-close any session from
    // /manager/devices.
    match /sessions/{sessionId} {
      allow read: if isAdmin() || (isSignedIn() && sessionId.matches(request.auth.uid + '_.*'));
      allow write: if isAdmin()
        || (isSignedIn()
            && sessionId.matches(request.auth.uid + '_.*')
            && request.resource.data.userId == request.auth.uid);
    }

    match /redirectCache/{code} {
      // /go/<code> is a public affiliate redirect link — anyone who has the
      // code (a 32^10-combination random string, not enumerable) can follow
      // it without being signed into this site, same as any link-shortener.
      // Only creating/retargeting a code is restricted to its owner.
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHitAt', 'expiresAt', 'hitCount']);
      allow delete: if false;

      match /hits/{hitId} {
        allow read: if isAdmin();
        allow create: if true;
        allow update, delete: if false;
      }
    }

    // Public, real values behind the "hoàn tiền dự kiến" estimate on
    // /get-cashback-link and the withdrawal minimum on /cashback-wallet —
    // readable by anyone (including logged-out visitors browsing before
    // signing in), editable only by the admin from /manager/settings.
    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders are entered manually by the admin (writeBatch, done together
    // with the linked ledger entries) instead of a server trigger reacting
    // automatically.
    //
    // The Telegram "✅ Duyệt đơn hàng" button (workers/telegram-bot) signs
    // in as the SAME isPaymentBot() account every other Telegram-driven
    // write in this file uses — a second narrow permission for it: flip a
    // PENDING order to CONFIRMED/CANCELLED, touching only
    // status/confirmedAt. The bot never originates an order — create stays
    // admin-only (only the admin's own /manager/orders form does that);
    // this only ever settles a decision on one the admin already entered.
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isPaymentBot();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isPaymentBot()
            && resource.data.status == 'PENDING'
            && request.resource.data.status in ['CONFIRMED', 'CANCELLED']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']));
    }

    // No time gate — admin has full discretion on when to release a
    // held commission to the user's withdrawable balance (deliberate
    // choice: a hard-coded wait risks losing customers who feel stalled,
    // so the human judgment call replaces the rule here).
    //
    // isPaymentBot() gets two narrow permissions here: (1) create a FROZEN
    // entry — needed so "✅ Duyệt đơn hàng" above can complete the SAME
    // commission-split write the admin's own web approval does, without
    // ever touching the web session — bounded to a valid type and an
    // orderId that must already exist, so a leaked bot credential can at
    // worst create a spurious FROZEN hold referencing a real order, never
    // an outright fabricated payout (releasing it still needs a separate,
    // visually-reviewed "✅ Duyệt hoàn tiền" tap, same trust model as
    // everything else this bot does); and (2) flip that same FROZEN entry
    // to RELEASED/REJECTED, touching only status/releasedBy/releasedAt.
    // delete stays admin-only.
    match /cashbackLedger/{ledgerId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isPaymentBot();
      allow delete: if isAdmin();
      allow create: if isAdmin()
        || (isPaymentBot()
            && request.resource.data.status == 'FROZEN'
            && request.resource.data.type in ['CUSTOMER_CASHBACK', 'REFERRAL_BONUS', 'PLATFORM_REVENUE']
            && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)));
      allow update: if isAdmin()
        || (isPaymentBot()
            && resource.data.status == 'FROZEN'
            && request.resource.data.status in ['RELEASED', 'REJECTED']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releasedBy', 'releasedAt']));
    }

    match /withdrawalRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || isPaymentBot();
      // Two allowed shapes: a regular user withdrawing their own cashback,
      // or the admin withdrawing the platform's 20% share out of the
      // virtual ADMIN_WALLET (never the admin's own personal uid, so it can
      // never be confused with — or accidentally merged into — a personal
      // withdrawal request). The customer branch additionally caps `amount`
      // against walletBalances/{uid}.available (see that match block) —
      // the only real server-side stop on a withdrawal request exceeding
      // the requester's actual balance; the ADMIN_WALLET branch is left as
      // it already was (a separate, admin-only, 20%-of-ledger calculation
      // on /manager/wallet, out of scope here).
      allow create: if isSignedIn()
        && request.resource.data.status == 'PENDING_ADMIN'
        && ((request.resource.data.userId == request.auth.uid
             && request.resource.data.amount <= get(/databases/$(database)/documents/walletBalances/$(request.auth.uid)).data.available)
            || (isAdmin() && request.resource.data.userId == 'ADMIN_WALLET'));
      allow update: if isAdmin()
        || (isPaymentBot()
            && resource.data.status in ['PENDING_ADMIN', 'APPROVED']
            && request.resource.data.status in ['PAID', 'REJECTED']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'rejectionReason']));
      // A REJECTED request never moved real money — safe for Admin to clear
      // a mistaken/test entry out of the history list. APPROVED/PAID stay
      // permanently undeletable (real audit trail).
      allow delete: if isAdmin() && resource.data.status == 'REJECTED';
    }

    match /fraudSignals/{signalId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Social-platform voucher codes shown on /social-vouchers — public to
    // any signed-in user (it's marketing content, not per-user data), only
    // Admin manages them from /manager/social-vouchers.
    match /socialVouchers/{voucherId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Registry of files each user/admin uploaded to their OWN personal
    // Google Drive (client-side OAuth, see lib/googleDrive.ts) — Firestore
    // only ever stores the resulting public URL, never file bytes.
    match /driveFiles/{fileId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // One thread per user (doc id == uid), written directly by both sides
    // for lowest-latency real-time delivery.
    match /supportChats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) && request.resource.data.sender == 'user')
          || (isAdmin() && request.resource.data.sender == 'admin');
        allow delete: if isOwner(uid) || isAdmin();
        allow update: if false;
      }
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
