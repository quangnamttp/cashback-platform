# Copy to functions/.env (Firebase CLI loads this automatically at deploy time).
# Never commit the real functions/.env file.

# Google Drive
# Uses Application Default Credentials (the project's default App Engine /
# Cloud Functions service account) — no key file needed. Enable the Drive
# API in Google Cloud Console, create a folder in Drive, and share it with
# "<project-id>@appspot.gserviceaccount.com" (Editor access), then paste
# that folder's id below.
DRIVE_FOLDER_ID=

# Fraud / payout tuning
PAYOUT_AUTO_THRESHOLD_VND=100000
CASHBACK_FREEZE_DAYS=15
REDIRECT_CACHE_TTL_HOURS=168
REDIRECT_CACHE_MAX_LIFETIME_DAYS=30

# The first user to sign up with this email is automatically granted the
# admin role (solves the bootstrap problem: promoting an admin normally
# requires an existing admin).
BOOTSTRAP_ADMIN_EMAIL=quangnamttp@gmail.com

# Region used for all callable/HTTP functions.
FUNCTIONS_REGION=asia-southeast1

# Public base URL of the deployed web app, used by goRedirect to build the
# fallback redirect when a cached link has expired.
WEB_BASE_URL=https://hoantiendv.web.app

# Optional: shared secret protecting the settleDueLedgerEntriesHttp endpoint,
# only needed if you wire an external free cron (GitHub Actions schedule,
# cron-job.org, ...) to call it periodically. Spark plan has no Cloud
# Scheduler, so this is the workaround for near-real-time payout settlement
# instead of relying purely on lazy settlement.
SETTLE_ENDPOINT_SECRET=
